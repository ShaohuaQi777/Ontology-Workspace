@prefix : <https://example.invalid/probe/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

: a owl:Ontology ;
    rdfs:label "complex.ttl" ;
    owl:versionInfo "1.0" .

:Node a owl:Class ;
    rdfs:label "Technical node" .

:p a owl:ObjectProperty ;
    rdfs:label "p" .

